PORT=4173
XIAN_GOVERNANCE_HOST=127.0.0.1
XIAN_NETWORK_ID=local
XIAN_NETWORK_NAME=Local Xian
XIAN_CHAIN_ID=
XIAN_RPC_URL=http://127.0.0.1:26657
XIAN_DASHBOARD_URL=http://127.0.0.1:8080
XIAN_GOVERNANCE_CONTRACT=governance
XIAN_MEMBERSHIP_CONTRACT=validators
# Comma-separated cross-origin allowlist for the API. Empty = same-origin only
# (the client is served by this same server, so CORS is opt-in). Use "*" to
# allow any origin.
CORS_ORIGINS=

# IPv6 bind hosts are unbracketed; IPv6 URL literals are bracketed.
# XIAN_GOVERNANCE_HOST=::1
# XIAN_RPC_URL=http://[::1]:26657
# XIAN_DASHBOARD_URL=http://[::1]:8080
