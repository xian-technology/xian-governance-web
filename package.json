{
  "name": "xian-governance-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Governance operations console for Xian validators.",
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "validate": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@tanstack/react-query": "^5.90.12",
    "@xian-tech/client": "file:../xian-js/packages/client",
    "@xian-tech/provider": "file:../xian-js/packages/provider",
    "@xian-tech/types": "file:../xian-js/packages/types",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.3",
    "jsdom": "^27.3.0",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.5"
  }
}
